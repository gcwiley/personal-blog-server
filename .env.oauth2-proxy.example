# Copy this file to `.env.oauth2-proxy` (gitignored) and fill in real values.
# Never commit the real .env.oauth2-proxy file.

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Application type: Web application)
OAUTH2_PROXY_CLIENT_ID=your-client-id.apps.googleusercontent.com
OAUTH2_PROXY_CLIENT_SECRET=your-client-secret

# Generate with:
#   python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
OAUTH2_PROXY_COOKIE_SECRET=replace-with-a-generated-32-byte-base64-secret
